# Pharos testnet configuration
PHAROS_RPC_URL=https://rpc.pharos.testnet
PHAROS_WS_URL=wss://rpc.pharos.testnet/ws
PHAROS_CHAIN_ID=12345
PRIVATE_KEY=YOUR_DEPLOYER_PRIVATE_KEY_HERE
AGENT_PRIVATE_KEY=YOUR_AGENT_PRIVATE_KEY_HERE
AGENT_ADDRESS=0x...
EMERGENCY_SAFE_ADDRESS=0x...
PHAROS_EXPLORER_API_KEY=

# Deployed contract addresses
TREASURY_MANAGER_ADDRESS=0x...
BOUNTY_MANAGER_ADDRESS=0x...
AGENT_PAYMENT_ROUTER_ADDRESS=0x...
RULE_ENGINE_ADDRESS=0x...

# Policy defaults
DAILY_LIMIT_PROS=1000
RESERVE_FLOOR_PROS=200
SUBMISSION_BOND_PROS=1
MULTISIG_THRESHOLD_PROS=100
TREASURY_MULTISIG_THRESHOLD_PROS=0

# Backend agent
HEALTH_PORT=8787
AGENT_LOOP_INTERVAL_MS=5000
BOUNTY_REVIEW_MODE=manual
MIN_AI_APPROVAL_SCORE=80
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-1.5-pro
AI_RATE_LIMIT_PER_HOUR=30
AI_MAX_PROOF_CHARS=6000
DATABASE_URL=sqlite:backend/data/agent.sqlite
SEED_TREASURY_PROS=25
SEED_BOUNTY_REWARD_PROS=2
SEED_SUBMISSION=false

# Optional alerts / AI
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GEMINI_API_KEY=
